#!/usr/bin/env bash
#MISE description="Stage a publishable copy of npm/ with the release's tag, asset name and digest injected"
#MISE dir="{{ config_root }}"

# Usage:  .config/mise/tasks/release/npm-package <SHA256SUMS> [<out-dir>]
#         mise run release:npm-package -- SHA256SUMS
#
# The published npm package carries no binary. It is an installer that
# downloads one asset from one GitHub Release and refuses it unless the bytes
# match a sha256 baked in at publish time — so this injection is the ENTIRE
# integrity story of that channel. Get it wrong and the package still publishes,
# still installs, and verifies a digest belonging to a different artifact.
#
# It lives here rather than in the `publish-npm` job's YAML for the reason
# `_rust_reassemble` does: `tests/release.rs` can run a script and cannot run a
# workflow step, and a step embedded in YAML is the one place in this repository
# nothing can execute it. It is also runnable by hand — point it at a
# `SHA256SUMS` downloaded from any tag and read the staged tree.
#
# The output is a COPY. `npm/` itself is never rewritten, so a release does not
# leave the working tree holding a tag's values.

set -e
set -o pipefail

# Sourced relative to THIS file rather than to `$MISE_PROJECT_ROOT`, because CI
# invokes this script by path: the `publish-npm` job installs no mise tools, for
# the same reason `publish` does not. `_rust_reassemble` is invoked the same way.
# shellcheck source-path=SCRIPTDIR
source "$(dirname "${BASH_SOURCE[0]}")/../_scripts/_rust"

manifest="${1:?usage: npm-package <SHA256SUMS> [<out-dir>]}"
out="${2:-target/npm}"

# `target/` is already gitignored, which is the whole reason the staging dir
# lives under it: a tree of tag-stamped files is build output, and a copy of the
# package sitting in the working tree is a second package.json to get wrong.
[ -f npm/package.json ] || {
  echo "no npm/package.json — there is nothing to stage" >&2
  exit 1
}
# The installer's pin. Required rather than created: if the package stopped
# reading this file, writing one nothing loads would publish a package with no
# digest check at all and no way to tell from here.
[ -f npm/asset.json ] || {
  echo "no npm/asset.json — the installer's digest pin is what this task exists to write" >&2
  exit 1
}

# TWO version lines, and this task touches neither.
#
# `version` here is the BINARY's — it names the release whose asset is pinned
# below, and nothing else. The npm package's own version is whatever
# `npm/package.json` carries, shipped as tracked and bumped by hand on its own
# line; see docs/decisions.md. This task used to stamp that manifest from
# `crate_version()`, back when the package carried the binary and one artifact
# would otherwise have claimed two versions of itself.
#
# `VERSION` is how CI hands down `verify`'s answer, which that job computed with
# this same `crate_version` and refused the release unless the pushed tag agreed
# with it. Reading it saves `publish-npm` a `cargo` it would otherwise have to
# install to ask the same question twice. On the installer's own release line it
# is handed the binary release being targeted instead.
version="${VERSION:-$(crate_version)}"
[ -n "$version" ] || {
  echo "no version: \$VERSION is unset and crate_version() returned nothing" >&2
  exit 1
}
tag="v${version}"

# The tarball, never the raw binary — the installer extracts an archive, and the
# two asset names collide on a prefix. `digest_for` compares the WHOLE name for
# exactly that reason and fails rather than returning empty on a miss; both are
# pinned by `the_digest_lookup_is_anchored_to_the_whole_asset_name` and
# `an_asset_missing_from_the_manifest_fails_instead_of_returning_empty` in
# `tests/release.rs`. It is the same lookup the tap's bump job uses, and that is
# the point: two channels pinning one digest must read it the same way.
#
# A target renamed or dropped out of `supported_targets` therefore fails HERE,
# naming the asset it looked for, which is why there is no separate guard for it.
name="$(asset_name darwin arm64).tar.gz"
digest="$(digest_for "$manifest" "$name")"

rm -rf "$out"
mkdir -p "$(dirname "$out")"
cp -R npm "$out"

# Written whole rather than patched. These three fields ARE the file, so a
# generated copy overwritten every release cannot drift from the release it
# describes — the same reasoning `render_formula` renders a whole formula on.
printf '{\n  "tag": "%s",\n  "name": "%s",\n  "sha256": "%s"\n}\n' \
  "$tag" "$name" "$digest" > "$out/asset.json"

# **The readme's asset URLs are NOT stamped here, and that is deliberate.** They
# were, for one release; the images now live at the site's stable `/media/` and
# there is nothing left to rewrite. Why: docs/decisions.md. Pinned by
# `every_image_in_the_npm_readme_is_served_by_the_site` in tests/npm.rs.

# The staged manifest is NOT rewritten. `package.json` ships exactly as tracked,
# which is what makes the installer's version its own: the only file this task
# writes is `asset.json`, and the only thing it says is which binary to fetch.

package="$(sed -nE 's/^[[:space:]]*"version"[[:space:]]*:[[:space:]]*"([^"]*)".*/\1/p' "$out/package.json")"
[ -n "$package" ] || {
  echo "staged package.json carries no version — npm publish would refuse it" >&2
  exit 1
}

echo "  staged $out"
echo "    package  $package   (the installer, published under this)"
echo "    installs $version   (the binary it fetches)"
echo "    tag      $tag"
echo "    asset    $name"
echo "    sha256   $digest"
