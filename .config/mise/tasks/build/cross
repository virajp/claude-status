#!/usr/bin/env bash
#MISE description="Build the release binary for every published target"
#MISE dir="{{ config_root }}"

#USAGE flag "--debug" help="emit debug logs"
#USAGE flag "--target <target>" help="build one Rust target triple instead of every one"

set -e
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/_helpers"
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/_rust"

cd "$MISE_PROJECT_ROOT"

[[ "${usage_debug:-false}" == "true" ]] && VERBOSE="--verbose" || VERBOSE=""

# CI builds each target on a runner that natively matches it, so this task is
# the local path. Both published targets are macOS, and Apple ships both slices
# of the system libraries — so on a Mac each one is either the host or a plain
# `rustup target add` away, with no cross toolchain, no linker to arrange and no
# C archiver to hunt down. That is the whole reason the supported set is what it
# is; see `supported_targets` in `_scripts/_rust`.
#
# On any other host this task cannot build anything, and says so rather than
# emitting a partial set.
host_target() {
  rustc -vV | awk '/^host:/ {print $2}'
}

if [[ "$(uname -s)" != "Darwin" ]]; then
  print_error "claude-status ships macOS binaries only, and they need a Mac to build."
  print_warn  "Cross-compiling to Apple targets needs the macOS SDK, which is not redistributable."
  print_warn  "CI builds each target on a native macOS runner; see .github/workflows/release.yml."
  exit 1
fi

build_one() {
  local target="$1"

  rustup target add "${target}" >/dev/null 2>&1 || true

  if [[ "${target}" == "$(host_target)" ]]; then
    print_wait "  ${target} (native) ... "
  else
    # The other macOS arch cross-compiles with nothing but the rustup target —
    # Apple ships both slices of the system libraries.
    print_wait "  ${target} (apple cross) ... "
  fi
  cargo build --release --target "${target}" ${VERBOSE} >/dev/null

  local bin="target/${target}/release/claude-status"
  if [[ ! -f "${bin}" ]]; then
    print_newline
    print_error "no binary at ${bin}"
    exit 1
  fi
  print_ok
  print_yellow "      $(file -b "${bin}")"
}

VERSION="$(crate_version)"
print_header "Building claude-status ${VERSION} ..."

if [[ -n "${usage_target:-}" ]]; then
  # Validated against the table rather than passed straight to cargo. The
  # removed Windows and Linux branches used to name the cause and the fix when
  # a target could not be built; without them an unsupported triple would print
  # "(apple cross)" and die in a raw linker error that explains nothing.
  # `-F` matters: without it the operator's value is a basic regular expression,
  # so `.*` — or any string that happens to match a triple — passes the guard
  # and reaches `cargo --target` and the `target/<t>/release` path.
  if ! supported_targets | awk '{print $1}' | grep -qxF -- "${usage_target}"; then
    print_error "${usage_target} is not a published target."
    print_warn  "claude-status ships macOS only. Published targets:"
    supported_targets | awk '{print "    " $1}'
    print_warn  "The list lives in .config/mise/tasks/_scripts/_rust; see contract §9."
    exit 1
  fi
  build_one "${usage_target}"
else
  while read -r target _os _cpu _exe; do
    [[ -z "${target}" ]] && continue
    build_one "${target}"
  done < <(supported_targets)
fi

print_header "Cross build done."
