#!/usr/bin/env bash
#MISE description="Build the statusline binary for every published target and smoke-test it"
#MISE dir="{{ config_root }}"
#MISE depends=["build:clean"]

#USAGE flag "--debug" help="emit debug logs"
#USAGE flag "--target <target>" help="build one Rust target triple instead of every one"

set -e
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/_helpers"
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/_rust"

cd "$MISE_PROJECT_ROOT"

# An array: quoted, an empty string is still an argument cargo must reject;
# unquoted, it only vanishes because of word-splitting.
VERBOSE=()
[[ "${usage_debug:-false}" == "true" ]] && VERBOSE=(--verbose)

# One task, both published targets. There used to be two — a `native` that built
# the host slice and smoke-tested it, and a `cross` that built the whole table
# without running anything. With the supported set down to macOS the split
# stopped paying for itself: the host is always one of the two rows, so building
# the table and then executing the host slice is strictly what both did.
#
# Everything lands in `target/<triple>/release/`, which is where
# `_rust_reassemble` and the release workflow's collect step look. Nothing
# writes the bare `target/release/` path any more — the plain
# `cargo build --release` in the readme's from-source escape hatch is the only
# thing that produces it, and no task reads it.
#
# CI builds each target on a runner that natively matches it, so the loop below
# is the local path; the workflow passes `--target` and gets one row. Both
# published targets are macOS, and Apple ships both slices of the system
# libraries — so on a Mac each one is either the host or a plain `rustup target
# add` away, with no cross toolchain, no linker to arrange and no C archiver to
# hunt down. That is the whole reason the supported set is what it is; see
# `supported_targets` in `_scripts/_rust`.
#
# On any other host this task cannot build anything, and says so rather than
# emitting a partial set.
host_target() {
  rustc -vV | awk '/^host:/ {print $2}'
}

if [[ "$(uname -s)" != "Darwin" ]]; then
  print_error "claude-status ships macOS binaries only, and they need a Mac to build."
  print_warn  "Cross-compiling to Apple targets needs the macOS SDK, which is not redistributable."
  print_warn  "CI builds each target on a native macOS runner; see .github/workflows/release.yml."
  exit 1
fi

build_one() {
  local target="$1"

  rustup target add "${target}" >/dev/null 2>&1 || true

  if [[ "${target}" == "$(host_target)" ]]; then
    print_wait "  ${target} (native) ... "
  else
    # The other macOS arch cross-compiles with nothing but the rustup target —
    # Apple ships both slices of the system libraries.
    print_wait "  ${target} (apple cross) ... "
  fi
  cargo build --release --target "${target}" "${VERBOSE[@]}" >/dev/null

  local bin="target/${target}/release/${BINARY_NAME}"
  if [[ ! -f "${bin}" ]]; then
    print_newline
    print_error "no binary at ${bin}"
    exit 1
  fi
  print_ok
  print_yellow "      $(file -b "${bin}")"
}

# Proves the artifact runs, not merely that it exists — and only for the host
# slice, because that is the one this machine can execute. The other arch is
# proven the same way on its own CI runner, which is the point of the build
# matrix in the release workflow.
smoke_test() {
  local bin="$1"

  # `--version` is the one output of this binary a script may parse, and this
  # check is one of its two consumers — the release workflow runs the identical
  # comparison on the artifact it is about to publish. A build that cannot
  # answer it with the bare crate version is a broken build.
  print_header "Smoke-testing ${bin} ..."
  local reported expected
  reported="$("./${bin}" --version)"
  expected="$(crate_version)"

  if [[ "${reported}" != "${expected}" ]]; then
    print_error "Binary reports ${reported}, Cargo.toml says ${expected}"
    exit 1
  fi

  # And that it renders without reaching the network. A closed port stands in
  # for the spend endpoint.
  print_header "Rendering a sample bar ..."
  printf '%s' '{"model":{"display_name":"Opus 5"},"cost":{"total_cost_usd":1.5}}' \
    | CLAUDE_STATUS_SPEND_URL="http://127.0.0.1:1/never" "./${bin}" --statusline > /dev/null

  print_header "Built claude-status ${reported} for $(uname -m)."
}

VERSION="$(crate_version)"
print_header "Building claude-status ${VERSION} ..."

if [[ -n "${usage_target:-}" ]]; then
  # Validated against the table rather than passed straight to cargo. The
  # removed Windows and Linux branches used to name the cause and the fix when
  # a target could not be built; without them an unsupported triple would print
  # "(apple cross)" and die in a raw linker error that explains nothing.
  # `-F` matters: without it the operator's value is a basic regular expression,
  # so `.*` — or any string that happens to match a triple — passes the guard
  # and reaches `cargo --target` and the `target/<t>/release` path.
  if ! supported_targets | awk '{print $1}' | grep -qxF -- "${usage_target}"; then
    print_error "${usage_target} is not a published target."
    print_warn  "claude-status ships macOS only. Published targets:"
    supported_targets | awk '{print "    " $1}'
    print_warn  "The list lives in .config/mise/tasks/_scripts/_rust; see contract §9."
    exit 1
  fi
  build_one "${usage_target}"
else
  while read -r target _os _cpu; do
    [[ -z "${target}" ]] && continue
    build_one "${target}"
  done < <(supported_targets)
fi

# The host slice is the only one this machine can run. When `--target` named the
# other arch there is nothing to smoke-test, and saying so beats staying silent.
HOST="$(host_target)"
if [[ -z "${usage_target:-}" || "${usage_target}" == "${HOST}" ]]; then
  smoke_test "target/${HOST}/release/${BINARY_NAME}"
else
  print_warn "Skipped the smoke test: ${usage_target} does not run on this ${HOST} host."
fi

print_header "Build done."
