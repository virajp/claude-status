#!/usr/bin/env bash
#MISE description="Stage the publishable npm package into target/npm/"
#MISE dir="{{ config_root }}"

#USAGE flag "--debug" help="emit debug logs"

set -e
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/_helpers"
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/_rust"

cd "$MISE_PROJECT_ROOT"

# The version of the BINARY — the GitHub release the installer will fetch from.
# It is not the npm package's version; see the manifest note below.
BINARY_VERSION="$(crate_version)"
OUT="target/npm"
PKG="${OUT}/claude-status"
ASSET="assets/claude-status.defaults.json"

print_header "Bundling the installer (tsup) ..."
pnpm exec tsup

if [[ ! -f npm/claude-status/bin/installer.mjs ]]; then
  print_error "tsup produced no npm/claude-status/bin/installer.mjs"
  exit 1
fi

print_header "Staging the npm package (binary ${BINARY_VERSION}) ..."
rm -rf "${OUT}"
mkdir -p "${PKG}"

cp -R npm/claude-status/. "${PKG}/"
# The readme IS the npm listing page, so a silent failure here publishes a
# package with no description of itself. npm includes README, LICENSE and
# package.json whatever `files` says, so staging them is all it takes.
cp readme.md "${PKG}/README.md"
cp LICENSE "${PKG}/LICENSE"
chmod 755 "${PKG}/bin/installer.mjs"

# The installer seeds a fresh config from the shipped defaults, so the asset
# ships beside the bundle. A byte copy of the ONE source of truth — never a
# re-encode, never a second hand-maintained copy: almost every symbol in it is
# a Nerd Font private-use codepoint that does not survive being rewritten.
install -m 644 "${ASSET}" "${PKG}/bin/claude-status.defaults.json"
if ! shasum -a 256 -c <(printf '%s  %s\n' \
  "$(shasum -a 256 "${ASSET}" | cut -d' ' -f1)" \
  "${PKG}/bin/claude-status.defaults.json") >/dev/null; then
  print_error "the staged defaults asset does not match ${ASSET}"
  exit 1
fi

# The checksums manifest — the whole integrity story in one file.
#
# GitHub release assets are MUTABLE: one can be deleted and re-uploaded at the
# same URL. npm versions are not. So the digest of every binary is pinned here,
# inside the immutable artifact, and the installer verifies the mutable download
# against it. That is what keeps the trust root on npm and reduces GitHub to a
# bytes-mover.
#
# `version` is the BINARY's version — the release tag to fetch from — and is
# deliberately NOT the npm package's version. The two are on separate lines
# while the fetch path is being proven against a real release, so that a `0.x`
# package can be republished freely without burning binary versions on installer
# bugs. When they are matched again this field simply names the same number, and
# nothing here changes.
#
# Keyed by `<os>-<cpu>` because that is exactly what `hostKey()` returns.
MANIFEST="${PKG}/bin/checksums.json"
missing=0
{
  printf '{\n  "version": "%s",\n  "assets": {\n' "${BINARY_VERSION}"
  first=1
  while read -r target os cpu; do
    [[ -z "${target}" ]] && continue
    bin="target/${target}/release/${BINARY_NAME}"
    if [[ ! -f "${bin}" ]]; then
      print_warn "  no binary at ${bin} (run build:statusline first)" >&2
      missing=$((missing + 1))
      continue
    fi
    digest="$(shasum -a 256 "${bin}" | cut -d' ' -f1)"
    [[ ${first} -eq 0 ]] && printf ',\n'
    first=0
    printf '    "%s-%s": { "file": "%s", "sha256": "%s" }' \
      "${os}" "${cpu}" "$(asset_name "${os}" "${cpu}")" "${digest}"
  done < <(supported_targets)
  printf '\n  }\n}\n'
} > "${MANIFEST}"

ENTRIES="$(node -p "Object.keys(require('./${MANIFEST}').assets).length")"
if [[ "${ENTRIES}" != "$(target_count)" ]]; then
  print_error "checksums.json names ${ENTRIES} targets, expected $(target_count)"
  print_warn  "a release must pin every target — run build:statusline for all of them"
  exit 1
fi
print_yellow "  pinned ${ENTRIES} binaries at ${BINARY_VERSION}"

# The npm package's own version is HAND-SET in npm/claude-status/package.json
# and is not substituted from Cargo.toml. It is reported by `--version` and is
# the number users install; the binary it fetches is named by the manifest.
PKG_VERSION="$(node -p "require('./${PKG}/package.json').version")"
if [[ "${PKG_VERSION}" == *"managed-by-cargo"* ]]; then
  print_error "npm/claude-status/package.json still carries the old placeholder"
  print_warn  "set a real version there — it is no longer substituted from Cargo.toml"
  exit 1
fi
print_yellow "  staged @askviraj/claude-status ${PKG_VERSION}"

print_header "Staged @askviraj/claude-status ${PKG_VERSION} (binary ${BINARY_VERSION}) in ${OUT}/."
if [[ "${missing}" -gt 0 ]]; then
  print_error "${missing} target(s) had no binary — this package cannot be released"
  exit 1
fi
