#!/usr/bin/env bash
#MISE description="Stage the publishable npm package into target/npm/"
#MISE dir="{{ config_root }}"

#USAGE flag "--debug" help="emit debug logs"

set -e
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/_helpers"
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/_rust"

cd "$MISE_PROJECT_ROOT"

# One version for the binary and the package, from the one place that owns it.
VERSION="$(crate_version)"
# The single published target, read from the table rather than spelled here.
read -r TARGET _os _cpu < <(supported_targets)
OUT="target/npm"
PKG="${OUT}/claude-status"
ASSET="assets/claude-status.defaults.json"

print_header "Bundling the installer (tsup) ..."
pnpm exec tsup

if [[ ! -f npm/claude-status/bin/installer.mjs ]]; then
  print_error "tsup produced no npm/claude-status/bin/installer.mjs"
  exit 1
fi

print_header "Staging @askviraj/claude-status ${VERSION} ..."
rm -rf "${OUT}"
mkdir -p "${PKG}"

cp -R npm/claude-status/. "${PKG}/"
# The readme IS the npm listing page, so a silent failure here publishes a
# package with no description of itself. npm includes README, LICENSE and
# package.json whatever `files` says, so staging them is all it takes.
cp readme.md "${PKG}/README.md"
cp LICENSE "${PKG}/LICENSE"
chmod 755 "${PKG}/bin/installer.mjs"

# The installer seeds a fresh config from the shipped defaults, so the asset
# ships beside the bundle. A byte copy of the ONE source of truth — never a
# re-encode, never a second hand-maintained copy: almost every symbol in it is
# a Nerd Font private-use codepoint that does not survive being rewritten.
install -m 644 "${ASSET}" "${PKG}/bin/claude-status.defaults.json"
if ! shasum -a 256 -c <(printf '%s  %s\n' \
  "$(shasum -a 256 "${ASSET}" | cut -d' ' -f1)" \
  "${PKG}/bin/claude-status.defaults.json") >/dev/null; then
  print_error "the staged defaults asset does not match ${ASSET}"
  exit 1
fi

# The binary itself. It travels INSIDE the package again.
#
# It briefly did not: the `github-artifacts` cycle moved it to a GitHub release
# asset the installer downloaded and verified. That bought one npm package
# instead of three — a benefit of not having per-platform packages, which having
# one target delivers for free. What was left was only cost: a required network
# call, broken air-gapped installs, an unhonoured HTTPS_PROXY, and a digest
# manifest to maintain against a MUTABLE release asset. Embedding deletes the
# problem rather than verifying around it, because there is no second artifact
# to distrust — npm versions are immutable and that is the whole integrity
# story.
BIN="target/${TARGET}/release/${BINARY_NAME}"
if [[ ! -f "${BIN}" ]]; then
  print_error "no binary at ${BIN}"
  print_warn  "run build:statusline first — a package staged without its binary is not releasable"
  exit 1
fi
install -m 755 "${BIN}" "${PKG}/bin/${BINARY_NAME}"
print_yellow "  staged ${BINARY_NAME} $("${BIN}" --version)"

# The installer reports its own `--version` from this manifest, and it must be
# the version of the binary beside it. The substitution is what makes that true;
# this is what stops it being silently untrue — a renamed placeholder or a
# hand-edited manifest would otherwise ship an installer that disagrees with the
# binary in the same tarball.
sed -i.bak "s|0\.0\.0-managed-by-cargo|${VERSION}|g" "${PKG}/package.json"
rm -f "${PKG}/package.json.bak"
STAMPED="$(node -p "require('./${PKG}/package.json').version")"
if [[ "${STAMPED}" != "${VERSION}" ]]; then
  print_error "package manifest says ${STAMPED}, Cargo.toml says ${VERSION}"
  exit 1
fi
print_yellow "  stamped the installer at ${VERSION}"

print_header "Staged @askviraj/claude-status ${VERSION} in ${OUT}/."
