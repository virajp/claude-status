#!/usr/bin/env bash
#MISE description="Build every target and stage the publishable npm packages"
#MISE dir="{{ config_root }}"
#MISE depends=["build:clean"]

#USAGE flag "--debug" help="emit debug logs"

set -e
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/_helpers"
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/_rust"

cd "$MISE_PROJECT_ROOT"

[[ "${usage_debug:-false}" == "true" ]] && DEBUG_FLAG="--debug" || DEBUG_FLAG=""

# What CI does across its per-target runners, in one command on one machine.
# Both published targets are macOS, so this needs nothing but a Mac and the two
# rustup targets.
line_sep "-"
mise run build:statusline ${DEBUG_FLAG}

line_sep "-"
mise run build:installer ${DEBUG_FLAG}

# The binaries no longer ship inside npm packages, so what has to be complete
# here is the CHECKSUM MANIFEST: an entry per target, each naming a release asset
# that the tag push must upload. A package pinning fewer than every target would
# install fine on the maintainer's own Mac and fail on the other architecture.
line_sep "-"
MANIFEST="target/npm/claude-status/bin/checksums.json"
PINNED="$(node -p "Object.keys(require('./${MANIFEST}').assets).length")"
EXPECTED="$(target_count)"
if [[ "${PINNED}" != "${EXPECTED}" ]]; then
  print_error "checksums.json pins ${PINNED}/${EXPECTED} targets — a release needs every one"
  exit 1
fi

BINARY_VERSION="$(crate_version)"
PKG_VERSION="$(node -p "require('./target/npm/claude-status/package.json').version")"
print_header "claude-status: npm ${PKG_VERSION}, binary ${BINARY_VERSION}, ${EXPECTED} targets pinned."
print_yellow "  Publishing is CI's job — push a v${BINARY_VERSION} tag to release."
if [[ "${PKG_VERSION}" != "${BINARY_VERSION}" ]]; then
  print_warn  "  npm and binary are on separate version lines — deliberate, and temporary."
  print_warn  "  See docs/plans/2026-08-22-2147-github-artifacts.md."
fi
