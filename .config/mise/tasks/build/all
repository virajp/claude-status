#!/usr/bin/env bash
#MISE description="Build every published target"
#MISE dir="{{ config_root }}"
#MISE depends=["build:clean"]

#USAGE flag "--debug" help="emit debug logs"

set -e
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/_helpers"
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/_rust"

cd "$MISE_PROJECT_ROOT"

[[ "${usage_debug:-false}" == "true" ]] && DEBUG_FLAG="--debug" || DEBUG_FLAG=""

# There is one thing to build. This task used to build the binary and then
# stage an npm package beside it, and check the two agreed on a version;
# `distribution/01` deleted the package, and the check with it — one artifact
# cannot disagree with itself.
#
# It is kept rather than folded away because `build:all` is the name
# CONTRIBUTING points people at, and because the day a second artifact returns
# it belongs here rather than inside `build:statusline`.
line_sep "-"
mise run build:statusline ${DEBUG_FLAG}

VERSION="$(crate_version)"
print_header "claude-status ${VERSION}: built into target/<triple>/release/."
print_yellow "  Releasing is CI's job — push a v${VERSION} tag."
