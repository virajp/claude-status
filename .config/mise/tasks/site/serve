#!/usr/bin/env bash
#MISE description="Serve the documentation site locally with live reload"
#MISE dir="{{ config_root }}"
#MISE depends=["site:assets"]

#USAGE flag "--port <port>" help="port to bind (default 1111)"
#USAGE flag "--open" help="open the site in the default browser"
#USAGE flag "--drafts" help="include pages marked draft"

set -e
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/_helpers"

cd "$MISE_PROJECT_ROOT"

# Development only. `site:build` is what CI and the deploy run; nothing
# automated ever calls this.
#
# `depends=["site:assets"]` for the same reason `site:build` has it: `zola
# serve` serves `static/` straight off disk, and without the staged schema and
# defaults the config generator page would load and then fetch two 404s. The
# copies are refreshed on every run, so editing the schema and restarting the
# server is enough — live reload does not watch `schemas/`.
#
# Deliberately NOT `--store-html`. By default `zola serve` keeps the rendered
# HTML in memory and only writes assets to `site/public/`, so a preview cannot
# leave a half-written tree behind for `site:build` to trip over. The directory
# is gitignored either way, but "the thing I served" and "the thing that ships"
# staying separate is worth the one flag not passed.
#
# The bound interface is left at zola's default of 127.0.0.1. This serves an
# unauthenticated preview of unreleased documentation; binding it to 0.0.0.0
# would publish that to every machine on the network, and there is no reason to
# reach for it.

PORT="${usage_port:-1111}"

# Arrays: quoted, an empty string is still an argument zola must reject;
# unquoted, it only vanishes because of word-splitting.
OPEN_FLAG=(); [[ "${usage_open:-false}" == "true" ]] && OPEN_FLAG=(--open)
DRAFT_FLAG=(); [[ "${usage_drafts:-false}" == "true" ]] && DRAFT_FLAG=(--drafts)

SITE_DIR="${MISE_PROJECT_ROOT}/site"

print_header "Serving the site on http://127.0.0.1:${PORT} (Ctrl-C to stop) ..."
print_yellow "  Live reload is on — edit anything under site/ and the page refreshes."

# `--base-url` is pinned to the loopback address the server actually answers
# on. Without it every absolute URL the templates emit — the stylesheet, the
# screenshot, every nav link — is built from the production `base_url` in
# site/config.toml, so a local preview quietly loads the deployed site's assets
# and its nav walks you off the machine. `zola serve` appends the port itself.
zola --root "${SITE_DIR}" serve \
  --interface 127.0.0.1 \
  --port "${PORT}" \
  --base-url 127.0.0.1 \
  "${OPEN_FLAG[@]}" "${DRAFT_FLAG[@]}"
