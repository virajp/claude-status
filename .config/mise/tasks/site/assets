#!/usr/bin/env bash
#MISE description="Copy the schema, the shipped defaults and the readme images into the site's static tree"
#MISE dir="{{ config_root }}"

set -e
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/_helpers"

cd "$MISE_PROJECT_ROOT"

# The config generator's two inputs, put where a browser can fetch them.
#
# ---------------------------------------------------------------------------
# WHY TWO FILES AND NOT ONE
# ---------------------------------------------------------------------------
#
# The page needs the *shape* and the *values*, and they live apart:
#
#   schemas/claude-status.schema.json   fields, types, bounds, enums, prose
#   assets/claude-status.defaults.json  what every one of those fields is set to
#
# The instinct is to read the defaults out of the schema's `default` keys. The
# schema has exactly FOUR of them — the `caps` thresholds — against a tree of
# roughly a hundred leaves, and that is deliberate: `config::schema::strip`
# removes every other one so the palette, the twenty symbols and the two layout
# rows (which carry Nerd Font private-use codepoints) stay out of a file dprint
# formats. `tests/schema.rs::the_only_defaults_in_the_schema_are_the_four_caps`
# pins it. A generator built on the schema's defaults would therefore show the
# user a config that is empty everywhere except `caps`, and would emit every
# key they touched as a change against nothing.
#
# ---------------------------------------------------------------------------
# WHY COPIED HERE RATHER THAN COMMITTED UNDER site/static/
# ---------------------------------------------------------------------------
#
# dprint's `includes` is `**/*.json`, and `assets/claude-status.defaults.json`
# is in its `excludes` at THAT PATH ONLY. A tracked second copy under
# `site/static/` would be matched, reformatted on commit, and would then differ
# byte for byte from the file it is a copy of — with nothing to say so. The
# same trap the schema already has a test for
# (`the_generated_schema_is_already_dprint_formatted`, whose comment explains
# how a formatter and a generator get into a loop).
#
# So the copies are build output: written here, gitignored, and excluded from
# dprint as a second line of defence. `tests/site.rs` asserts both, because a
# gitignore entry someone deletes is a tracked copy nobody notices.
#
# Copied rather than fetched from GitHub raw at runtime; see docs/decisions.md.

SITE_STATIC="${MISE_PROJECT_ROOT}/site/static"

print_header "Copying the schema and defaults into site/static/ ..."

for source in schemas/claude-status.schema.json assets/claude-status.defaults.json; do
  [ -f "${MISE_PROJECT_ROOT}/${source}" ] || {
    print_error "${source} is missing — the config generator has nothing to build a form from"
    exit 1
  }
  # `cp` and not a symlink: zola copies `static/` into `public/` and a symlink
  # would land in the deploy artifact as a link to a path the Pages host has
  # no idea about.
  command cp "${MISE_PROJECT_ROOT}/${source}" "${SITE_STATIC}/$(basename "${source}")"
done

# No `cmp` pass here. There was one, and it could not fail: it ran immediately
# after the unconditional `cp` above, so the drift it claimed to catch ("a
# formatter or an editor having touched the destination between runs") had just
# been overwritten, and a `cp` that genuinely fails already exits non-zero under
# `set -e`. A guard that reads as protection and provides none is worse than no
# guard. The real byte check lives in
# `tests/site.rs::the_schema_and_the_shipped_defaults_are_staged_rather_than_committed`,
# which compares source against staged copy at a point where they can differ.

# The npm readme's images, at a stable `/media/` address. A SECOND copy of
# `site/static/statusline.png`, which `site:build` fingerprints: the site's own
# pages want that cache-busting and a published npm readme cannot chase a name
# that changes every deploy. Staged rather than tracked, so a re-render cannot
# land on one copy only. Why not GitHub raw: docs/decisions.md.

MEDIA_DIR="${SITE_STATIC}/media"
mkdir -p "${MEDIA_DIR}"

print_header "Copying the readme images into site/static/media/ ..."

for image in lockup.png statusline.png; do
  [ -f "${MISE_PROJECT_ROOT}/assets/${image}" ] || {
    print_error "assets/${image} is missing — every published npm readme points at /media/${image} and would render a broken image on the registry"
    exit 1
  }
  # `cp` and not a symlink, for the reason above the staging loop.
  command cp "${MISE_PROJECT_ROOT}/assets/${image}" "${MEDIA_DIR}/${image}"
done

# The agent runbook, at `/install.md` — the address the install prompt in both
# readmes hands an agent, so it has to outlive every published copy of that
# prompt. Staged rather than tracked because dprint formats `**/*.md` and would
# rewrite a copy that must stay byte-identical to its source. Never
# fingerprinted: the fingerprint list in `site:build` is an explicit set of
# names. Why not GitHub raw: docs/decisions.md.

print_header "Copying the agent runbook into site/static/ ..."

[ -f "${MISE_PROJECT_ROOT}/install.md" ] || {
  print_error "install.md is missing — every prompt in the readmes points at /install.md and would fetch a 404"
  exit 1
}
# `cp` and not a symlink, for the reason above the staging loop.
command cp "${MISE_PROJECT_ROOT}/install.md" "${SITE_STATIC}/install.md"

print_header "Schema, defaults, readme images and the runbook staged in site/static/"
