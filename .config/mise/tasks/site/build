#!/usr/bin/env bash
#MISE description="Build the documentation site (zola) and check its internal links"
#MISE dir="{{ config_root }}"
#MISE depends=["site:assets"]

#USAGE flag "--drafts" help="include pages marked draft"
#USAGE flag "--minify" help="minify the generated HTML"

set -e
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/_helpers"

cd "$MISE_PROJECT_ROOT"

# No `--debug` flag, unlike every `code:*` task. Those pass `--verbose` through
# to cargo; zola 0.23 has no verbosity control at all, so the flag would be a
# lie in the usage output. `--drafts` and `--minify` are the two knobs it does
# have that anyone would reach for.
#
# It `depends` on ONE thing — `site:assets`, which stages the JSON schema and
# the shipped defaults into `site/static/` for the config generator to fetch.
# That is a step of this build rather than a chain into another gate: without
# it `zola build` copies a `static/` tree missing two files the generator page
# needs, and the failure would be a page that loads and then does nothing.
# `site:serve` depends on it for the same reason.
#
# Beyond that it chains into NOTHING, and that is deliberate.
#
# It is not in `code:all`. `code:all` is the code-quality gate — format, lint,
# test, security scan — and it is what the pre-commit hook and the release
# workflow both run. Hanging the docs build off it would couple a typo fix to
# the binary's gate in exactly the direction this cycle set out to avoid: the
# whole reason the site ships on its own `site-v*` tag line is that a docs
# correction should not need a binary release, and a docs *build* should not
# need the binary's test suite either.
#
# It is not in `build:all` either, which `depends=["build:clean"]` — an
# `rm -rf target` that has nothing to do with `site/` and costs a full Rust
# rebuild afterwards.
#
# Run it directly, or let .github/workflows/site.yml run it. Nothing else does.

# Arrays: quoted, an empty string is still an argument zola must reject;
# unquoted, it only vanishes because of word-splitting.
DRAFT_FLAG=(); [[ "${usage_drafts:-false}" == "true" ]] && DRAFT_FLAG=(--drafts)
MINIFY_FLAG=(); [[ "${usage_minify:-false}" == "true" ]] && MINIFY_FLAG=(--minify)

SITE_DIR="${MISE_PROJECT_ROOT}/site"

print_header "Building the site (zola) ..."

# `--root` rather than a `cd`: zola resolves `content/`, `templates/`,
# `static/` and the output directory relative to it, so the task stays runnable
# from anywhere and the paths it prints stay absolute.
zola --root "${SITE_DIR}" build "${DRAFT_FLAG[@]}" "${MINIFY_FLAG[@]}"

# The internal-link check, and the reason this site pins no separate crawler.
#
# `zola check` validates `@/page.md` links in CONTENT and nothing else. It does
# not look at a root-relative `/nope/`, a `../gone/`, or any href inside a Tera
# template — all three were probed against 0.23.4 and all three pass silently.
# So the site holds two conventions that turn the build itself into the check:
#
#   content   — every internal link is `@/<page>.md`, which `zola check` reads
#   templates — every internal link is `get_url(path="@/<page>.md")`, which
#               the `zola build` above hard-fails on when the target is gone
#
# `tests/site.rs` enforces both mechanically, so the conventions are not left to
# whoever edits the site next.
#
# `--skip-external-links` is not laziness: leaving them on makes a green build
# depend on github.com and anthropic.com being up, and a docs deploy that
# cannot ship because someone else had an outage is worse than a stale link.
# External links are a human check.
print_header "Checking internal links (zola check) ..."
zola --root "${SITE_DIR}" check --skip-external-links

# **Make self-links root-relative.**
#
# Zola resolves both `get_url()` and a markdown `@/page.md` link against
# `base_url`, so the built HTML is full of `https://claude-status.virajp.dev/…`.
# The templates strip the prefix themselves (see `base.html`), but markdown
# links have no filter hook, so the last 22 come out absolute regardless.
#
# Absolute self-links break every host that is not production: Cloudflare Pages
# serves preview deployments from `*.pages.dev`, and a reviewer clicking a nav
# link would be thrown to the production domain -- which, until the DNS record
# exists, does not resolve at all. The same applies to opening `public/` locally.
#
# `base_url` stays the production URL rather than becoming `/`, because it is
# what makes `sitemap.xml`'s `<loc>` entries and `robots.txt`'s `Sitemap:` line
# absolute, which the sitemaps spec requires. So the rewrite is scoped to
# `*.html` and those two files keep their prefix -- which is asserted below,
# because a `find` that quietly widened would silently break the sitemap.
BASE_URL="$(awk -F'"' '/^base_url/ { print $2 }' "${SITE_DIR}/config.toml")"
[ -n "${BASE_URL}" ] || { print_error "could not read base_url from config.toml"; exit 1; }

print_header "Rewriting self-links to root-relative ..."
# `perl -pi`, not `sed -i`. BSD sed wants `-i ''` and GNU sed reads that empty
# string as a filename, so the macOS form fails on the ubuntu runner this
# workflow actually uses -- and the workflow has never run, so nothing would
# have said so until the first `site-v*` tag. `perl -pi -e` behaves identically
# on both, and perl is preinstalled on macOS and on ubuntu-24.04 (it is what
# `shasum` is written in, which the release workflow already depends on).
# `\Q…\E` quotes the URL so its `/` and `:` are literal.
#
# SCOPED TO `href` AND `src`, and not to the whole file. The OpenGraph and
# Twitter tags in `base.html` carry the same base_url inside `content="…"` and
# MUST stay absolute: a crawler unfurling a shared link resolves them against
# nothing, so a root-relative `og:image` is a preview with no picture. An
# unscoped rewrite ate them, which is why this is two narrow passes rather than
# one wide one.
for attr in href src; do
  find "${SITE_DIR}/public" -name '*.html' \
    -exec perl -pi -e "s|${attr}=\"\Q${BASE_URL}\E/|${attr}=\"/|g" {} +
done

remaining=0
for attr in href src; do
  n="$(grep -rlF "${attr}=\"${BASE_URL}" "${SITE_DIR}/public" --include='*.html' | wc -l | tr -d ' ')"
  remaining=$((remaining + n))
done
if [ "${remaining}" != "0" ]; then
  print_error "${remaining} built page(s) still carry an absolute self-link"
  for attr in href src; do
    grep -rnF "${attr}=\"${BASE_URL}" "${SITE_DIR}/public" --include='*.html' | head -5
  done
  exit 1
fi

# The other direction for the PAGES: the link-preview tags must have survived.
# If the rewrite ever widens again this is what says so, rather than a silently
# picture-less preview nobody notices until they share a link.
for og in og:url og:image; do
  if ! grep -qF "property=\"${og}\" content=\"${BASE_URL}" "${SITE_DIR}/public/index.html"; then
    print_error "${og} is no longer absolute — the self-link rewrite was too wide"
    grep -nF "${og}" "${SITE_DIR}/public/index.html" | head -3
    exit 1
  fi
done

# The other direction: the rewrite must NOT have reached the two files whose
# whole job is to carry absolute URLs.
for must_keep in sitemap.xml robots.txt; do
  if ! grep -q "${BASE_URL}" "${SITE_DIR}/public/${must_keep}"; then
    print_error "${must_keep} lost its absolute base_url — the rewrite was too wide"
    exit 1
  fi
done

# ---------------------------------------------------------------------------
# FINGERPRINTING
# ---------------------------------------------------------------------------
#
# Every asset that can change between releases ships as `name.<hash>.ext`, and
# every reference to it is rewritten to match.
#
# WHY, precisely: Cloudflare Pages serves the HTML `max-age=0,
# must-revalidate` and static assets with a lifetime of their own. Those are
# not the same freshness, so a returning reader gets the NEW html against an
# OLD stylesheet, and nothing requires the two to be compatible. That is not
# hypothetical -- it is how the first production deploy of the redesign looked
# broken to everyone who had visited before, and correct to everyone who had
# not: a blank logo (the old stylesheet defined no `--surface-accent`, so the
# mark's `fill="var(--surface-accent)"` resolved to nothing) and a screenshot
# running off the side of the page (no `.hero-shot img { width: 100% }`).
#
# A hash in the FILENAME removes the failure rather than shortening it. Changed
# bytes are a different file at a different address, so the old one can be held
# forever and still never be served against HTML that does not ask for it --
# which is what makes the `immutable` year in `_headers` below safe.
#
# A query string (`style.css?h=...`) busts a cache too, but the path stays
# stable, so `immutable` on it would be a promise about a URL whose content CAN
# change. The filename form is the one that makes the header honest.
#
# ORDER MATTERS. Fonts are named inside `style.css`, so they are fingerprinted
# first; hashing them rewrites the stylesheet, which changes the bytes the
# stylesheet's OWN hash is taken over. Doing it the other way round ships a
# stylesheet whose hash does not match its contents.
#
# NOT FINGERPRINTED, deliberately: `claude-status.schema.json` and
# `claude-status.defaults.json`. `config-generator.js` fetches them by relative
# name at runtime (`new URL(name, import.meta.url)`), so renaming them breaks
# the form with a 404 that nothing here would catch. They are marked
# must-revalidate in `_headers` instead, which is the correct answer for data
# that is fetched by a stable name.
print_header "Fingerprinting assets ..."

PUB="${SITE_DIR}/public"

fingerprint() {
  rel="$1"
  src="${PUB}/${rel}"
  if [ ! -f "${src}" ]; then
    print_error "fingerprint: ${rel} is not in the build output"
    exit 1
  fi

  # 12 hex chars. Collision is not the threat model here -- serving the wrong
  # cached file is, and 48 bits is far past what a handful of assets needs.
  hash="$(shasum -a 256 "${src}" | cut -c1-12)"
  dir="$(dirname "${rel}")"
  base="$(basename "${rel}")"
  name="${base%.*}"
  ext="${base##*.}"
  if [ "${dir}" = "." ]; then
    newrel="${name}.${hash}.${ext}"
  else
    newrel="${dir}/${name}.${hash}.${ext}"
  fi

  mv "${src}" "${PUB}/${newrel}"

  # Rewritten in html AND css: the stylesheet is where the font faces are
  # named, and the pages are where everything else is.
  find "${PUB}" \( -name '*.html' -o -name '*.css' \) \
    -exec perl -pi -e "s|\Q${rel}\E|${newrel}|g" {} +

  echo "  ${rel} -> ${newrel}"
}

# Fonts first -- see ORDER MATTERS above.
for font in "${PUB}"/fonts/*.woff2; do
  [ -e "${font}" ] || { print_error "no fonts in the build output"; exit 1; }
  fingerprint "fonts/$(basename "${font}")"
done

for asset in style.css copy-code.js config-generator.js statusline.png og-card.png favicon.svg; do
  fingerprint "${asset}"
done

# Nothing may still point at an un-fingerprinted name. A rewrite that missed
# would 404 in production and pass every check that only reads the source.
for asset in style.css copy-code.js config-generator.js statusline.png og-card.png favicon.svg; do
  if grep -rqF "/${asset}" "${PUB}" --include='*.html' --include='*.css'; then
    print_error "a reference to un-fingerprinted /${asset} survived the rewrite"
    grep -rnF "/${asset}" "${PUB}" --include='*.html' --include='*.css' | head -5
    exit 1
  fi
done

# ---------------------------------------------------------------------------
# `_headers` -- Cloudflare Pages reads this from the root of the output.
# ---------------------------------------------------------------------------
#
# It is generated rather than committed under `static/` so it cannot drift from
# what is actually fingerprinted above.
print_header "Writing _headers ..."
cat > "${PUB}/_headers" <<'HEADERS'
# Generated by .config/mise/tasks/site/build. Do not edit by hand.

# The default: revalidate every time. HTML must never be held, because it is
# what names the fingerprinted assets.
/*
  Cache-Control: public, max-age=0, must-revalidate

# Fingerprinted assets. The hash is in the filename, so these bytes can never
# change at this address -- which is what makes a year and `immutable` safe.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/*.css
  Cache-Control: public, max-age=31536000, immutable
/*.js
  Cache-Control: public, max-age=31536000, immutable
/*.png
  Cache-Control: public, max-age=31536000, immutable
/*.svg
  Cache-Control: public, max-age=31536000, immutable

# `claude-status.schema.json` and `claude-status.defaults.json` are NOT
# fingerprinted -- the config generator fetches them by relative name at
# runtime, so they keep a stable address. They need no rule of their own: they
# fall under `/*` above and revalidate every time, which is what data at a
# stable name requires. Listing them again only made Cloudflare emit the same
# directives twice in one header.
HEADERS

print_header "Site built into ${SITE_DIR}/public"
