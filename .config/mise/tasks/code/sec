#!/usr/bin/env bash
#MISE description="Security scan (grype + gitleaks)"
#MISE dir="{{ config_root }}"

#USAGE flag "--debug" help="emit debug logs"

set -e
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/_helpers"

# Every other task in this library pins its directory; this one did not, and
# `grype .` resolved against whatever the caller's cwd happened to be. Run from
# a sibling worktree it scanned the siblings too, reporting an `esbuild`/npm
# finding that looks exactly like this repo having reacquired a JavaScript
# toolchain. It had not. Both scanners now take an absolute path.
cd "$MISE_PROJECT_ROOT"

# Arrays, not strings. An empty string is still an ARGUMENT when quoted, and
# unquoted it relies on word-splitting — which also means a project path with a
# space in it would have split `--config /some/path` into the wrong pieces.
# An empty array expands to nothing at all, which is what "no flag" means.
GRYPE_FLAGS=(); LEAK_FLAGS=()
if [[ "${usage_debug:-false}" == "true" ]]; then
  GRYPE_FLAGS=(-vv)
  LEAK_FLAGS=(--verbose)
fi

# Use repo configs when present, else tool defaults
GRYPE_CFG=(); [[ -f "${MISE_PROJECT_ROOT}/.config/grype.yaml" ]] && GRYPE_CFG=(--config "${MISE_PROJECT_ROOT}/.config/grype.yaml")
LEAK_CFG=(); [[ -f "${MISE_PROJECT_ROOT}/.config/gitleaks.toml" ]] && LEAK_CFG=(--config "${MISE_PROJECT_ROOT}/.config/gitleaks.toml")

print_header "Scanning dependencies with grype ..."
grype "${MISE_PROJECT_ROOT}" --name "$(basename "${MISE_PROJECT_ROOT}")" "${GRYPE_CFG[@]}" "${GRYPE_FLAGS[@]}"

print_header "Scanning for secrets with gitleaks ..."
gitleaks dir "${MISE_PROJECT_ROOT}" "${LEAK_CFG[@]}" --redact 50 "${LEAK_FLAGS[@]}"

print_header "Scanning done"
