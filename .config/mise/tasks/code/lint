#!/usr/bin/env bash
#MISE description="Lint code (clippy, actionlint, shellcheck)"

#USAGE flag "--debug" help="emit debug logs"
#USAGE flag "--fix" help="apply fixes"

set -e
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/_helpers"

# An array, not a string: quoted, an empty string is still an argument cargo
# has to reject; unquoted, it relies on word-splitting. An empty array expands
# to nothing, which is what "no flag" actually means.
VERBOSE=()
[[ "${usage_debug:-false}" == "true" ]] && VERBOSE=(--verbose)

if [[ "${usage_fix:-false}" == "true" ]]; then
  print_header "Linting (clippy --fix) ..."
  cargo clippy --manifest-path "${MISE_PROJECT_ROOT}/Cargo.toml" --all-targets --fix --allow-dirty --allow-staged "${VERBOSE[@]}"
fi

print_header "Linting (clippy) ..."
# Warnings are errors: the render path must not accumulate lint debt, and the
# pre-commit hook is the only thing enforcing it.
#
# Twice, because the two builds are different code. The bare pass is what
# `cargo build --release` compiles — the shipped binary, with no `schemars`
# anywhere in it. The `--features schema` pass is the author-time generator,
# which `--all-targets` alone would never reach: `required-features` skips the
# `schema` bin and `#[cfg(feature = "schema")]` skips the module.
cargo clippy --manifest-path "${MISE_PROJECT_ROOT}/Cargo.toml" --all-targets "${VERBOSE[@]}" -- -D warnings

print_header "Linting (clippy --features schema) ..."
cargo clippy --manifest-path "${MISE_PROJECT_ROOT}/Cargo.toml" --all-targets --features schema "${VERBOSE[@]}" -- -D warnings

# The release workflow is the least-tested code in the repo — it runs on a tag,
# so a mistake is found by cutting a release. actionlint reads it statically,
# and shells out to shellcheck for every `run:` block.
#
# Suppressions live in `.github/actionlint.yaml` rather than as flags here, so
# the pre-commit hook and this task cannot drift apart. That file explains the
# two it carries and when to delete them.
print_header "Linting (actionlint) ..."
actionlint

# `-x` follows sourced files, so the `_scripts/` libraries are analysed as the
# task scripts actually see them rather than as orphans full of undefined names.
#
# **Found, not listed.** This was one glob per task directory, and that shape
# had two failure modes, both of which were hit within a day of each other: a
# new directory was invisible to this gate until somebody remembered to add it
# — `merge/` was, for exactly one commit — and once tasks nested (`code/merge/`)
# the parent's glob handed shellcheck a *directory*, which it cannot read.
# Walking the tree has neither problem, and there is no list to keep in step.
#
# `-exec ... +` rather than a pipe to `xargs`: it batches the same way, it does
# not run at all when nothing matches, and its non-zero exit reaches `set -e`
# here — which a pipeline's would not.
print_header "Linting (shellcheck) ..."
find "${MISE_PROJECT_ROOT}/.config/mise/tasks" \
  -type f ! -name '*.md' \
  -exec shellcheck -x {} +

print_header "Linting done"
