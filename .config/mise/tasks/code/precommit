#!/usr/bin/env bash
#MISE description="Run pre-commit hooks"
#MISE hide=true

#USAGE flag "--all" help="Run on all files (default: only changed files)"

set -e
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/_helpers"

# **No `|| true`.** It used to swallow every hook's exit code, which made this
# task a formatter with a progress report rather than a gate: the schema-drift
# hook could fail on every run and `code:precommit` would still exit 0.
#
# The cost is real and worth naming. `dprint` has `markdown.textWrap: "always"`,
# so the `formatter` hook *rewrites* files on a first run over unformatted
# prose — and pre-commit reports a rewrite as a failure. That is the correct
# report: something changed and the commit's contents are not what was staged.
# Re-run the task and it passes, because there is nothing left to rewrite.
if [[ "${usage_all:-false}" == "true" ]]; then
  print_header "Running pre-commit on all files ..."
  pre-commit run --config .config/pre-commit-config.yaml --all-files
else
  print_header "Running pre-commit on changed files ..."
  mapfile -t changed_files < <(git diff --name-only --diff-filter=d HEAD)
  if [[ ${#changed_files[@]} -eq 0 ]]; then
    print_header "No changed files to scan."
  else
    pre-commit run --config .config/pre-commit-config.yaml --files "${changed_files[@]}"
  fi
fi
