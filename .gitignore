# vwf scratch — mockup renders for visual review, never part of the contract
docs/scratchpad/

# vwf memory — the rooms that hold one developer's session state, not the team's
docs/memory/handoff/
docs/memory/doctor/
docs/memory/runs/

# code-intelligence graph — rebuilt locally, never committed
graphify-out/

# the built site — zola's output, regenerated by `site:build` and uploaded by
# .github/workflows/site.yml. Nothing reads it from a checkout.
site/public/

# the config generator's two inputs, staged into the static tree by
# `site:assets` on every build. They are copies of `schemas/` and `assets/`,
# and a tracked copy would be reformatted by dprint into a file that no longer
# matches its source. See the task for the whole reasoning; `tests/site.rs`
# asserts these two lines are still here.
site/static/claude-status.schema.json
site/static/claude-status.defaults.json

# the two images the npm readme loads over https, staged into the static tree
# by `site:assets` on every build. Copies of `assets/`, kept at a stable
# `media/` address because a published npm version names its URLs forever. They
# are ignored for the same reason as the two above: a tracked second copy is a
# file that drifts from its source with nothing to say so — and for an image
# that has already happened here once. See the task for the whole reasoning;
# `tests/site.rs` asserts these two lines are still here.
site/static/media/lockup.png
site/static/media/statusline.png


# Added by cargo

/target

# vwf plans — executed cycles, kept on disk for the local record but not in the
# repo. The active plans and docs/plans/index.md carry what a reader needs.
docs/plans/archived/

# Claude Code — the worktree pool and machine-local settings only. Everything
# else under .claude/ is shared configuration and belongs in the repo.
.claude/worktrees/
.claude/settings.local.json
